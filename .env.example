# 访问口令（必填，局域网访问 / 本机写操作会用到）
WORKBENCH_PASSCODE=

# GLM（AI 编辑部 / 自主写稿可选模型）：claude CLI 走智谱 Anthropic 兼容端点
# ZHIPUAI_API_KEY=
# ZHIPUAI_MODEL=glm-4.6

# DeepSeek（同上，走 DeepSeek Anthropic 兼容端点；现役模型 deepseek-flash / deepseek-v4-pro）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# 数据工作区根目录（可选）。
# 默认 = 本项目的上级目录（阿茶AI实验室 仓库布局）。
# 分离部署 / 分享试用时，指向自己的数据目录（其下需有 01-内容库、02-发布工具 等结构，缺的模块对应功能自动停用）：
# ACHA_WS_ROOT=/path/to/your/workspace

# 数据目录（可选）。默认 <工作台>/data；测试已用临时目录，不会碰真实数据。
# WORKBENCH_DATA_DIR=

# Folo CLI 路径（可选，雷达源需要；也可用 PATH 里的 folo）
# WB_FOLO_BIN=

# 标题翻译（可选）：FOLO_TRANSLATE=0 关闭；FOLO_TRANSLATE_MODEL=minimax 切换模型
